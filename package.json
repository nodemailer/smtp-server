{
    "name": "smtp-server",
    "version": "3.19.21",
    "description": "Create custom SMTP servers on the fly",
    "main": "lib/smtp-server.js",
    "scripts": {
        "test": "grunt",
        "test:bun": "bun node_modules/.bin/_mocha --exit test/*-test.js",
        "test:coverage": "c8 --include 'lib/**' --check-coverage --lines 88 --branches 85 --functions 90 --reporter=text --reporter=lcov mocha --exit 'test/*-test.js'",
        "compare": "node compare/compare.js",
        "postfix:start": "bash compare/postfix.sh start",
        "postfix:stop": "bash compare/postfix.sh stop",
        "format": "prettier --write \"**/*.{js,json,md}\"",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "author": "Andris Reinman",
    "license": "MIT-0",
    "dependencies": {
        "ipv6-normalize": "1.0.1",
        "nodemailer": "10.1.0",
        "punycode.js": "2.3.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "c8": "12.0.0",
        "chai": "4.4.1",
        "eslint": "10.12.0",
        "grunt": "1.6.3",
        "grunt-cli": "1.5.0",
        "grunt-eslint": "27.0.0",
        "grunt-mocha-test": "0.13.3",
        "mocha": "10.7.3",
        "pem": "1.14.8",
        "prettier": "3.9.10"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/nodemailer/smtp-server.git"
    },
    "bugs": {
        "url": "https://github.com/nodemailer/smtp-server/issues"
    },
    "keywords": [
        "SMTP"
    ],
    "engines": {
        "node": ">=20.0.0"
    }
}
