{
    "name": "smtp-server",
    "version": "3.20.2",
    "description": "Create custom SMTP servers on the fly",
    "type": "module",
    "main": "./dist/cjs/smtp-server.js",
    "types": "./dist/cjs/smtp-server.d.ts",
    "typesVersions": {
        "*": {
            "lib/*.js": [
                "dist/cjs/*.d.ts"
            ],
            "lib/*": [
                "dist/cjs/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/smtp-server.js",
            "require": "./dist/cjs/smtp-server.js"
        },
        "./lib/*.js": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./lib/*": {
            "import": "./dist/esm/*.js",
            "require": "./dist/cjs/*.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "SECURITY.md",
        "SECURITY.txt"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 $(find test -name '*-test.ts')",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 $(find test -name '*-test.ts')",
        "pretest:bun": "npm run build",
        "test:bun": "bun test --timeout 60000 $(find ./test -name '*-test.ts')",
        "compare": "node --import tsx compare/compare.ts",
        "postfix:start": "bash compare/postfix.sh start",
        "postfix:stop": "bash compare/postfix.sh stop",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md}\"",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "author": "Andris Reinman",
    "license": "MIT-0",
    "dependencies": {
        "ipv6-normalize": "1.0.1",
        "nodemailer": "10.1.7",
        "punycode.js": "2.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "20.19.43",
        "@types/pem": "^1.14.4",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "pem": "1.14.8",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/nodemailer/smtp-server.git"
    },
    "bugs": {
        "url": "https://github.com/nodemailer/smtp-server/issues"
    },
    "homepage": "https://nodemailer.com/extras/smtp-server/",
    "keywords": [
        "SMTP",
        "LMTP"
    ],
    "engines": {
        "node": ">=20.0.0"
    }
}
